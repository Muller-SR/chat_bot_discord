# Token do bot criado no Discord Developer Portal
DISCORD_TOKEN=cole_o_token_do_bot_aqui

# ID do servidor de testes do Discord
DISCORD_GUILD_ID=123456789012345678

# Provedor: auto escolhe Gemini, OpenAI ou modo demo conforme as chaves disponíveis
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Banco SQLite criado automaticamente
DATABASE_PATH=data/mestre_rpg.sqlite3
